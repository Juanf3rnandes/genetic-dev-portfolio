# Lido pelo Cloudflare (Workers Static Assets / Pages). Ignorado no GitHub Pages.

# Isolamento cross-origin: o arcade (mGBA com threads) precisa de SharedArrayBuffer.
# Com estes headers vindos do servidor, o arcade funciona sem o service worker
# e sem o recarregamento extra na primeira visita.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# arquivos com hash no nome nunca mudam: cache longo
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/mgba/*
  Cache-Control: public, max-age=604800
